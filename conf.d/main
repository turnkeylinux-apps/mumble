#!/bin/bash -ex

SRC=/usr/local/src
WEBROOT=/var/www

a2enmod rewrite

a2dissite 000-default.conf
a2ensite tkl-webcp.conf

mv /var/www/js /var/www/tkl-webcp
mv /var/www/css /var/www/tkl-webcp
mkdir /var/www/tkl-webcp/images
mv /var/www/images/* /var/www/tkl-webcp/images
rm -rf /var/www/images

# Add the appliance name to Mumble's server configuration.
sed -Ei 's|^[;#]?registerName=.*|registerName=TurnKey Mumble Server|' \
    /etc/mumble/mumble-server.ini

# Enable the Ice administration interface.
sed -Ei 's|^[;#]?ice=.*|ice="tcp -h 127.0.0.1 -p 6502"|' \
    /etc/mumble/mumble-server.ini

phpenmod ice

systemctl enable murmurdautofirewall || update-rc.d murmurdautofirewall defaults
